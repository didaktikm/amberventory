# Настройки AmberVentory для `docker run --env-file` и Docker Compose.
# Скопируйте в .env, ограничьте доступ (chmod 600 .env) и не коммитьте .env в git.
# Полный список переменных: docs/configuration.md

# Адрес веб-интерфейса. 127.0.0.1: доступ только через reverse proxy на этом же хосте.
AMBER_HOST=127.0.0.1
AMBER_PORT=8080

# HTTP basic auth. Пустой AMBER_PASSWORD отключает аутентификацию: не делайте этого вне стенда.
AMBER_USER=admin
AMBER_PASSWORD=

# Параллельных SSH-сессий при сборе.
AMBER_FORKS=25

# Ключ API NVD: ускоряет загрузку CVSS (https://nvd.nist.gov/developers/request-an-api-key).
# NVD_API_KEY=

# Пакеты под наблюдением: glob через запятую. По умолчанию список из app/config.py.
# AMBER_WATCHLIST=openssl,openssh,php*,sudo,glibc,linux,nginx

# Выход в интернет через прокси.
# HTTPS_PROXY=http://proxy.corp.local:3128
# NO_PROXY=localhost,127.0.0.1,.corp.local

# Внутренние зеркала баз уязвимостей (изолированный контур).
# AMBER_TRACKER_URL=https://mirror.corp.local/debian-security-tracker.json
# AMBER_KEV_URL=https://mirror.corp.local/known_exploited_vulnerabilities.json
# AMBER_EPSS_URL=https://mirror.corp.local/epss_scores-current.csv.gz
